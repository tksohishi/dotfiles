#!/usr/bin/env bun
// Read-only Zerion wallet reads. ZERION_API_KEY comes from the current
// directory's .env (Bun loads it), so run it from a project that has the key.
// Not the official zerion-cli: that one ships wallet-signing and swap code,
// which a portfolio read has no use for.

const BASE = "https://api.zerion.io/v1";

const USAGE = `usage: zerion <command> <address> [--json]

commands:
  portfolio   total value, split by position type and chain
  positions   fungible positions, largest first (spam filtered)`;

const [cmd, address, ...rest] = Bun.argv.slice(2);
const json = rest.includes("--json");

const key = process.env.ZERION_API_KEY;
if (!key) {
  console.error("ZERION_API_KEY not set (run from a directory whose .env has it)");
  process.exit(1);
}
if (!cmd || !address || !/^0x[0-9a-fA-F]{40}$|^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(address)) {
  console.error(USAGE);
  process.exit(2);
}

async function get(path: string): Promise<any> {
  // The free key 429s on two back-to-back calls; one retry after a pause covers a single read.
  for (let attempt = 0; attempt < 3; attempt++) {
    const r = await fetch(`${BASE}${path}`, {
      headers: { authorization: `Basic ${btoa(`${key}:`)}`, accept: "application/json" },
    });
    if (r.ok) return r.json();
    if (r.status === 429 || r.status >= 500) {
      await new Promise((res) => setTimeout(res, 5000));
      continue;
    }
    console.error(`zerion ${r.status}: ${(await r.text()).slice(0, 200)}`);
    process.exit(1);
  }
  console.error("zerion: gave up after 3 attempts (rate limited)");
  process.exit(1);
}

const usd = (n: number | null | undefined) =>
  (n ?? 0).toLocaleString("en-US", { style: "currency", currency: "USD" });

const sorted = (o: Record<string, number> = {}) =>
  Object.entries(o).filter(([, v]) => v >= 0.01).sort(([, a], [, b]) => b - a);

if (cmd === "portfolio") {
  const res = await get(`/wallets/${address}/portfolio?currency=usd`);
  if (json) {
    console.log(JSON.stringify(res, null, 2));
    process.exit(0);
  }
  const a = res.data.attributes;
  console.log(`total  ${usd(a.total?.positions)}`);
  console.log(`24h    ${usd(a.changes?.absolute_1d)} (${(a.changes?.percent_1d ?? 0).toFixed(2)}%)`);
  console.log("\nby type");
  for (const [k, v] of sorted(a.positions_distribution_by_type)) console.log(`  ${k.padEnd(10)} ${usd(v)}`);
  console.log("\nby chain");
  for (const [k, v] of sorted(a.positions_distribution_by_chain)) console.log(`  ${k.padEnd(20)} ${usd(v)}`);
} else if (cmd === "positions") {
  const res = await get(
    `/wallets/${address}/positions/?filter[positions]=no_filter&filter[trash]=only_non_trash&currency=usd&sort=value`,
  );
  if (json) {
    console.log(JSON.stringify(res, null, 2));
    process.exit(0);
  }
  for (const row of res.data ?? []) {
    const a = row.attributes;
    if ((a.value ?? 0) < 0.01) continue;
    const chain = row.relationships?.chain?.data?.id ?? "?";
    const kind = a.position_type === "wallet" ? "" : ` [${a.position_type}${a.protocol ? ` ${a.protocol}` : ""}]`;
    console.log(
      `${usd(a.value).padStart(14)}  ${(a.fungible_info?.symbol ?? "?").padEnd(10)} ${chain}${kind}  ${a.quantity?.float ?? ""}`,
    );
  }
} else {
  console.error(USAGE);
  process.exit(2);
}
