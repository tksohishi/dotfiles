#!/usr/bin/env bun
// Fetch bot-walled pages with headed patchright real-Chrome (see fetch-blocked skill).
//
// Usage: patchright-fetch <url>... [--wait <seconds>] [--show]
//
// - Every URL must be on one host. The first call for a host starts a background
//   Chrome for it; later calls for that host reuse the same window, and it closes
//   after IDLE_SEC without a request. The focus switch at launch is paid once per
//   research burst, not per call.
// - Headed only: headless is detected even on a trusted profile. The window opens
//   offscreen by default so it doesn't take over the screen; --show puts it onscreen
//   (needed when a captcha/Press & Hold must be solved by hand) and closes it right
//   after that call.
// - Per-host persistent profile under ~/.cache/patchright-fetch/, shared across
//   projects so a PX-class wall solved once is trusted everywhere; each page's body
//   text is saved to ~/.cache/patchright-fetch/<host>/<path>.txt. The background
//   Chrome logs to <host>.log there.
// - --wait is a per-page cap, not a fixed sleep: polls every 2s and moves on once the
//   body text is stable and no challenge marker is on screen.
// - Bun auto-installs the pinned patchright below into its global cache on first run;
//   needs Chrome Canary installed.
import { execFileSync, spawn } from 'node:child_process'
import { existsSync, mkdirSync, openSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { createConnection, createServer, type Socket } from 'node:net'

const IDLE_SEC = 120
const usage = 'usage: patchright-fetch <url>... [--wait <seconds>] [--show]'
const cacheDir = `${process.env.XDG_CACHE_HOME ?? `${process.env.HOME}/.cache`}/patchright-fetch`
const paths = (host: string) => ({
  sock: `${cacheDir}/${host}.sock`,
  lock: `${cacheDir}/${host}.lock`,
  log: `${cacheDir}/${host}.log`,
  profile: `${cacheDir}/${host}-profile`,
})

type Request = { urls: string[]; waitSec: number; show: boolean }
type Reply = { out?: string; err?: string; restart?: boolean; done?: boolean; code?: number }

const args = process.argv.slice(2)
if (args[0] === '--serve') await serve(args[1], args[2] === 'show')
else await client(args)

async function client(args: string[]) {
  const showIdx = args.indexOf('--show')
  const show = showIdx >= 0
  if (show) args.splice(showIdx, 1)
  const waitIdx = args.indexOf('--wait')
  const waitSec = waitIdx >= 0 ? Number(args.splice(waitIdx, 2)[1]) : 20
  if (args.length === 0 || Number.isNaN(waitSec)) {
    console.error(usage)
    process.exit(1)
  }
  let urls: URL[] = []
  try {
    urls = args.map((a) => new URL(a))
  } catch {
    console.error(`not a valid URL among: ${args.join(' ')}`)
    process.exit(1)
  }
  const hostOf = (u: URL) => u.hostname.replace(/^www\./, '')
  const host = hostOf(urls[0])
  if (urls.some((u) => hostOf(u) !== host)) {
    console.error(`all URLs must be on one host (${host}); run once per host`)
    process.exit(1)
  }
  mkdirSync(`${cacheDir}/${host}`, { recursive: true })
  const p = paths(host)
  const req: Request = { urls: urls.map((u) => u.href), waitSec, show }

  for (let attempt = 0; attempt < 2; attempt++) {
    let res = await send(p.sock, req)
    if (res === null) {
      const exited = startServer(host, show)
      const deadline = Date.now() + 60000
      while (res === null && Date.now() < deadline && !exited()) {
        await new Promise((r) => setTimeout(r, 300))
        res = await send(p.sock, req)
      }
      if (res === null) {
        console.error(`ERROR: background Chrome for ${host} did not start; log: ${p.log}`)
        try {
          console.error(readFileSync(p.log, 'utf8').trim().split('\n').slice(-5).join('\n'))
        } catch {}
        process.exit(1)
      }
    }
    if (res !== 'restart') process.exit(res)
    // The running window is in the other --show mode; it is shutting down, so wait for its socket to go.
    const deadline = Date.now() + 15000
    while (existsSync(p.sock) && Date.now() < deadline) await new Promise((r) => setTimeout(r, 200))
  }
  process.exit(1)
}

// null when nothing is listening, 'restart' when the server is in the other mode, else the exit code.
function send(sock: string, req: Request): Promise<number | 'restart' | null> {
  return new Promise((resolve) => {
    let settled = false
    const finish = (v: number | 'restart' | null) => {
      if (!settled) {
        settled = true
        resolve(v)
      }
    }
    const s = createConnection(sock)
    let connected = false
    let buf = ''
    s.on('connect', () => {
      connected = true
      s.write(`${JSON.stringify(req)}\n`)
    })
    s.on('data', (d) => {
      buf += d
      let i = buf.indexOf('\n')
      while (i >= 0) {
        const m: Reply = JSON.parse(buf.slice(0, i))
        buf = buf.slice(i + 1)
        if (m.out != null) console.log(m.out)
        if (m.err != null) console.error(m.err)
        if (m.restart) finish('restart')
        if (m.done) finish(m.code ?? 0)
        i = buf.indexOf('\n')
      }
    })
    s.on('error', () => finish(connected ? 1 : null))
    s.on('close', () => finish(connected ? 1 : null))
  })
}

function startServer(host: string, show: boolean): () => boolean {
  const log = openSync(paths(host).log, 'w')
  const child = spawn(process.execPath, [process.argv[1], '--serve', host, show ? 'show' : 'offscreen'], {
    detached: true,
    stdio: ['ignore', log, log],
  })
  let exited = false
  child.on('exit', () => {
    exited = true
  })
  child.unref()
  return () => exited
}

async function serve(host: string, show: boolean) {
  const p = paths(host)
  // One Chrome per host profile: a second one dies on Chrome's SingletonLock. A
  // live holder means another server won the race; its socket will answer.
  if (existsSync(p.lock)) {
    const pid = Number(readFileSync(p.lock, 'utf8'))
    try {
      if (pid > 0 && pid !== process.pid) {
        process.kill(pid, 0)
        process.exit(0)
      }
    } catch {}
  }
  writeFileSync(p.lock, String(process.pid))

  // Chrome activates itself on launch even with the window offscreen, stealing keyboard
  // focus from whatever the user is typing in. Hand focus back, but only while Canary is
  // still in front, so a deliberate app switch by the user is never undone.
  // (lsappinfo setfront would avoid the re-activation flash but returns permErr.)
  const frontBundle = () => {
    try {
      const info = execFileSync('lsappinfo', ['info', execFileSync('lsappinfo', ['front']).toString().trim()]).toString()
      return info.match(/bundleID="([^"]+)"/)?.[1]
    } catch {}
  }
  const userApp = show ? undefined : frontBundle()
  const restoreFocus = () => {
    if (userApp && frontBundle() === 'com.google.Chrome.canary') execFileSync('open', ['-b', userApp])
  }

  let ctx: any
  let stopping = false
  let idle: ReturnType<typeof setTimeout> | undefined
  const server = createServer()
  const shutdown = async () => {
    if (stopping) return
    stopping = true
    clearTimeout(idle)
    server.close()
    await ctx?.close().catch(() => {})
    restoreFocus()
    rmSync(p.sock, { force: true })
    rmSync(p.lock, { force: true })
    process.exit(0)
  }
  const arm = () => {
    clearTimeout(idle)
    idle = setTimeout(shutdown, IDLE_SEC * 1000)
  }

  try {
    // @ts-expect-error bun resolves versioned specifiers via auto-install
    const { chromium } = await import('patchright@1.60.0')
    ctx = await chromium.launchPersistentContext(p.profile, {
      channel: 'chrome-canary',
      chromiumSandbox: true,
      headless: false,
      args: show ? [] : ['--window-position=-2400,-2400'],
    })
  } catch (err) {
    const msg = err instanceof Error ? err.message.split('\n')[0] : String(err)
    console.error('ERROR:', msg)
    if (/chrome-canary|executable/i.test(msg)) console.error('hint: Chrome Canary must be installed (brew install --cask google-chrome@canary)')
    rmSync(p.lock, { force: true })
    process.exit(1)
  }
  restoreFocus()
  ctx.on('close', shutdown)
  const page = ctx.pages()[0] ?? (await ctx.newPage())

  let queue = Promise.resolve()
  server.on('connection', (sock: Socket) => {
    let buf = ''
    sock.on('data', (d) => {
      buf += d
      const i = buf.indexOf('\n')
      if (i < 0) return
      const req: Request = JSON.parse(buf.slice(0, i))
      buf = ''
      queue = queue.then(() => handle(req, sock))
    })
    sock.on('error', () => {})
  })

  async function handle(req: Request, sock: Socket) {
    clearTimeout(idle)
    const reply = (m: Reply) => sock.writable && sock.write(`${JSON.stringify(m)}\n`)
    if (req.show !== show) {
      reply({ restart: true })
      sock.end()
      await shutdown()
      return
    }
    let code = 0
    for (const href of req.urls) code = Math.max(code, await fetchOne(new URL(href), req, reply))
    reply({ done: true, code })
    sock.end()
    if (show) await shutdown()
    else arm()
  }

  const CHALLENGE = /press & hold|press and hold|verify you are|just a moment|checking your browser|are you a robot/i
  const outPath = (u: URL) => {
    const slug = `${u.pathname}${u.search}`.replace(/^\/+|\/+$/g, '').replace(/[^A-Za-z0-9._-]+/g, '_')
    const name = slug || 'index'
    return `${cacheDir}/${host}/${/\.(txt|md)$/.test(name) ? name : `${name}.txt`}`
  }

  async function fetchOne(url: URL, req: Request, reply: (m: Reply) => unknown): Promise<number> {
    try {
      await page.goto(url.href, { waitUntil: 'domcontentloaded', timeout: 45000 })
      const deadline = Date.now() + req.waitSec * 1000
      let text = ''
      let prev = -1
      while (Date.now() < deadline) {
        await page.waitForTimeout(2000)
        text = await page.innerText('body').catch(() => '')
        // Length within 2% of the previous poll counts as settled: dynamic pages
        // (ads, lazy-loaded listings) never reach exact text equality.
        const settled = text.length > 0 && prev >= 0 && Math.abs(text.length - prev) <= prev * 0.02
        if (settled && !CHALLENGE.test(text)) break
        prev = text.length
      }
      const title = await page.title()
      // The first response can be a challenge page, so judge the document that settled.
      const html = (await page.evaluate(() => document.contentType).catch(() => 'text/html')).includes('html')
      const out = outPath(url)
      writeFileSync(out, text)
      reply({ out: `URL: ${page.url()}\nTITLE: ${title}\nLEN: ${text.length} → ${out}` })
      if (req.urls.length === 1) reply({ out: `---\n${text.slice(0, 2500)}` })
      if (CHALLENGE.test(text)) {
        reply({ err: 'challenge unsolved at --wait cap; rerun with --show to solve it by hand' })
        return 1
      }
      if ((html && !title.trim()) || text.length < 1000) {
        reply({ err: 'WARN: empty title or body under 1KB — likely a dead URL, not a bot wall. Re-check with a URL known to be live before recording the host as blocked' })
      }
      return 0
    } catch (err) {
      reply({ err: `ERROR: ${url.href} ${err instanceof Error ? err.message.split('\n')[0] : String(err)}` })
      return 1
    }
  }

  rmSync(p.sock, { force: true })
  server.listen(p.sock, arm)
}
