{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "init": "off",
    "fewer-permission-prompts": "off"
  },
  "env": {
    "GOG_JSON": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "/Users/takeshi/.claude/moshi-plugin"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(sqlite3*backlog.db*)",
      "Bash(agent-browser *--all*)",
      "Bash(codex exec *--dangerously-bypass*)",
      "Bash(codex exec *danger-full-access*)",
      "Bash(git clean -df*)",
      "Bash(git clean -f*)",
      "Bash(git clean -xdf*)",
      "Bash(git clean -xf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gog auth tokens export*)",
      "Bash(hermes *--accept-hooks*)",
      "Bash(hermes *--ignore-rules*)",
      "Bash(hermes *--ignore-user-config*)",
      "Bash(hermes *--yolo*)",
      "Bash(reboot*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~/*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(shutdown*)",
      "Bash(sudo *)",
      "Edit(//**/.dev.vars)",
      "Edit(//**/.env)",
      "Edit(//**/.env.dev)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.prod)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.stage)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.test)",
      "Edit(//**/.prod.vars)",
      "Read(//**/.dev.vars)",
      "Read(//**/.env)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.development)",
      "Read(//**/.env.local)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.production)",
      "Read(//**/.env.stage)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.prod.vars)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "mcp__claude_ai_Gmail"
    ],
    "ask": [
      "Bash(/Applications/CuaDriver.app/*)",
      "Bash(brew install*)",
      "Bash(brew uninstall*)",
      "Bash(bun add -g*)",
      "Bash(caddy add-package*)",
      "Bash(caddy remove-package*)",
      "Bash(caddy stop*)",
      "Bash(caddy upgrade*)",
      "Bash(claude plugin install *)",
      "Bash(cua-driver *)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(gog email send*)",
      "Bash(gog gmail send*)",
      "Bash(gog mail send*)",
      "Bash(just key-add*)",
      "Bash(just key-backup*)",
      "Bash(just key-copy*)",
      "Bash(just key-rm*)",
      "Bash(just new-wallet*)",
      "Bash(launchctl bootout *)",
      "Bash(launchctl bootstrap *)",
      "Bash(launchctl disable *)",
      "Bash(launchctl enable *)",
      "Bash(launchctl load *)",
      "Bash(launchctl remove *)",
      "Bash(launchctl submit *)",
      "Bash(launchctl unload *)",
      "Bash(mise exec*)",
      "Bash(mise x *)",
      "Bash(op *)",
      "Bash(qpdf *--replace-input*)",
      "Bash(rsync * --delete*)",
      "Bash(rsync --delete*)",
      "Bash(security *)",
      "Bash(sfltool *)",
      "Bash(yt-dlp *--exec*)",
      "Edit(//opt/homebrew/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp",
      "~/.agent-browser",
      "~/.cache",
      "~/Library/Caches"
    ]
  },
  "model": "opus",
  "availableModels": [
    "fable",
    "opus",
    "sonnet"
  ],
  "enforceAvailableModels": true,
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    {
      "serverName": "claude-in-chrome"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent-followup-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agents-md-no-incidents.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/webfetch-blocked-domains.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/outbound-private.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-antipatterns.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/httpie-flag-order.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/grep-repo-wide.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ls-long.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-remote-ssh.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gog-mutations.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-io-in-scripts.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-explicit-paths.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-trailer.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-pipe-delimiter-alternation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/one-change-per-call.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/wrap-up-japanese.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-prose-symbols.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-bot-detection-bypass.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-example-secrets.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/reply-language.ts",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/replace-dollar.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/zsh-expansion.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/markdown-size.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/loop-wakeup-state.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "CronCreate|CronDelete",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/cron-state.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ci-gate-record.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ci-gate.sh",
            "asyncRewake": true,
            "timeout": 1800
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"UserPromptSubmit\\\",\\\"additionalContext\\\":\\\"Current local time: $(date '+%A %Y-%m-%d %H:%M:%S %Z')\\\"}}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/skill-in-prompt.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/ja-spacing.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/utc-time.ts",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/handoff-load.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-title.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-bang-sudo.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun $HOME/.claude/hooks/reply-language.ts",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 30
  },
  "enabledPlugins": {},
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push --force*) in tksohishi/dotfiles — public repo with no branch protection on main; force-push is a footgun without a safety net",
      "Bash(rm -rf ~*) — CLAUDE.md itself notes rm -rf of home paths should be avoided in favor of trash"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Public — tksohishi/dotfiles (github.com:tksohishi/dotfiles.git)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: 1Password CLI (`op read`) — used for secret retrieval; never read `.env`/`.env.*`/`.dev.vars`/`.prod.vars` files directly",
      "**Default / protected branches**: main (default). No branch protection rules or rulesets listed via gh — treat main as unprotected but still avoid force-push/history rewrite without explicit direction",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (tksohishi/dotfiles) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Never read `.env`, `.env.<env>`, `.dev.vars`, `.prod.vars` files via any tool. Never copy real personal data (phone numbers, emails, addresses, names) into test fixtures or committed code.",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal dotfiles/machine-setup management (shell configs, editor settings, tool preferences, AI agent configs) — hobby/personal use",
      "**Trusted repo**: tksohishi/dotfiles (this repo, public) at /Users/takeshi/.dotfiles, and its origin remote. Since the repo is public, only this repo's own work (dotfiles, scripts, configs authored here) is OK to push — content ported or first read from elsewhere is not, and secrets/personal data are never cleared into it regardless of visibility.",
      "**Org-specific CLIs**: None configured — repo uses personal-workflow CLIs (gog, hermes, tg, agent-browser, ctx7, mise, trash, fd, http/httpie, bats) per CLAUDE.md conventions, not org-internal tools",
      "routine under scripts/, dotclaude/, dotagents/, dotcodex/ prefixes within /Users/takeshi/.dotfiles is standard maintenance work for this repo"
    ]
  }
}
