{
  "hooks": {
    "PreToolUse": [
      {
        "_dotfiles": true,
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/bash-antipatterns.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/httpie-flag-order.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/gog-mutations.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/env-io-in-scripts.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/env-example-secrets.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/git-explicit-paths.sh"
          }
        ]
      }
    ]
  }
}
